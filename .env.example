# Copy this file to .env and fill in real values before running.
# Never commit the real .env to git.

PORT=3000

# --- Payment provider ---
# "mock" (default) needs nothing below in this section — lets you demo the
# full flow with no real payment account. Switch to "beam" only after
# beamProvider.js is implemented against real Beam API docs.
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=mock-secret-change-me

# Fill in once you have a real Beam merchant account:
# BEAM_SECRET_KEY=
# BEAM_API_BASE=https://api.beamcheckout.com

# --- MQTT / IoT broker (Adafruit IO by default) ---
# These credentials live ONLY here on the server now — never in the
# frontend/browser. Get them from io.adafruit.com -> key icon ("My Key").
AIO_USERNAME=
AIO_KEY=
MQTT_HOST=io.adafruit.com
MQTT_PORT=8883

# --- Admin auth ---
ADMIN_JWT_SECRET=change-this-to-a-long-random-string
# Used only the very first time the DB is created (seeds one admin user):
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme123

# --- Database ---
# Defaults to ./data/narmpack.db if unset.
# DB_PATH=./data/narmpack.db

# ID of the machine seeded on first run (30 compartments created under it).
DEFAULT_MACHINE_ID=machine-01
